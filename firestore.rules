rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection:
    // Authenticated users can read/write their own admin profile or if they are admin
    match /admins/{userId} {
      allow get, list: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Surat Masuk & Keluar (Letters collection)
    // Accessible to authenticated users of the school
    match /letters/{letterId} {
      allow read, write: if isAuthenticated();
    }

    // School settings (identity, kepala sekolah, operator, tahun buku)
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    // Audit logs
    match /logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
